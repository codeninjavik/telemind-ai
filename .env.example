# Copy these into Netlify (Site configuration > Environment variables) or run:
#   npx netlify env:set NAME value
# For local `npm run dev` put them in a file named .env (it is git-ignored). Never commit real values.

# Login password for the dashboard (choose a long one)
ADMIN_PASSWORD=
# Random 32+ character string. Signs the login cookie and encrypts the Telegram session at rest.
APP_SECRET=

# From https://my.telegram.org > API development tools (your own account)
TG_API_ID=
TG_API_HASH=

# From https://console.groq.com/keys
GROQ_API_KEY=
